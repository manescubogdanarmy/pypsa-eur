        <mxCell id="synth_hdr" value="SYNTHESIS — resilience as a verifiable, inter-comparable property" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0F7B3B;strokeColor=#0F7B3B;fontSize=11;fontStyle=1;fontColor=#FFFFFF;fontFamily=Helvetica;align=center;" vertex="1" parent="1">
          <mxGeometry x="60" y="552" width="1130" height="28" as="geometry" />
        </mxCell>
        <mxCell id="synth_body" value="Resilience is operationalised as five indicator families surfaced by the deterministic seven-CSV contract.&#10;Every indicator is expressed in SI units (GWh, EUR, EUR/MWh, MWh), reproducible from the same artefacts, and inter-comparable across scenarios, deployments and borders.&#10;The recovery / absorption / adaptation triplet is therefore measured, not asserted." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F7FAFF;strokeColor=#0F7B3B;fontSize=11;fontColor=#1E2B3A;fontFamily=Helvetica;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="60" y="584" width="1130" height="90" as="geometry" />
        </mxCell>

        <mxCell id="footer" value="Source: authors. Indicator families derived from the project's result contract; regulatory alignment from Directive (EU) 2022/2555 (NIS2) and Directive (EU) 2022/2557 (CER)." style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=9;fontColor=#5D6A7B;fontFamily=Helvetica;fontStyle=2;" vertex="1" parent="1">
