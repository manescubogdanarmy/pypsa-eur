        <mxCell id="lmp_hdr_m" value="Metric" style="text;html=1;strokeColor=none;fillColor=#072A75;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=10;fontStyle=1;fontColor=#FFFFFF;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="736" y="308" width="120" height="28" as="geometry" />
        </mxCell>
        <mxCell id="lmp_hdr_b" value="Baseline" style="text;html=1;strokeColor=none;fillColor=#072A75;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=10;fontStyle=1;fontColor=#FFFFFF;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="856" y="308" width="150" height="28" as="geometry" />
        </mxCell>
        <mxCell id="lmp_hdr_s" value="Scenario" style="text;html=1;strokeColor=none;fillColor=#072A75;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=10;fontStyle=1;fontColor=#FFFFFF;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="1006" y="308" width="150" height="28" as="geometry" />
        </mxCell>
        <mxCell id="lmp_hdr_d" value="Delta" style="text;html=1;strokeColor=none;fillColor=#072A75;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=10;fontStyle=1;fontColor=#FFFFFF;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="1156" y="308" width="190" height="28" as="geometry" />
        </mxCell>

        <mxCell id="lmp_min_m" value="Min LMP" style="text;html=1;strokeColor=none;fillColor=#F3F7FF;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=10;fontColor=#1E2B3A;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="736" y="336" width="120" height="28" as="geometry" />
        </mxCell>
        <mxCell id="lmp_min_b" value="25 EUR/MWh" style="text;html=1;strokeColor=none;fillColor=#F3F7FF;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=10;fontColor=#1E2B3A;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="856" y="336" width="150" height="28" as="geometry" />
        </mxCell>
        <mxCell id="lmp_min_s" value="45 EUR/MWh" style="text;html=1;strokeColor=none;fillColor=#F3F7FF;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=10;fontColor=#1E2B3A;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="1006" y="336" width="150" height="28" as="geometry" />
        </mxCell>
        <mxCell id="lmp_min_d" value="+20 EUR/MWh (+80 %)" style="text;html=1;strokeColor=none;fillColor=#F3F7FF;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=10;fontColor=#C4372A;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="1156" y="336" width="190" height="28" as="geometry" />
        </mxCell>

        <mxCell id="lmp_mean_m" value="Mean LMP" style="text;html=1;strokeColor=none;fillColor=#FFFFFF;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=10;fontColor=#1E2B3A;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="736" y="364" width="120" height="28" as="geometry" />
        </mxCell>
        <mxCell id="lmp_mean_b" value="65 EUR/MWh" style="text;html=1;strokeColor=none;fillColor=#FFFFFF;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=10;fontColor=#1E2B3A;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="856" y="364" width="150" height="28" as="geometry" />
        </mxCell>
        <mxCell id="lmp_mean_s" value="145 EUR/MWh" style="text;html=1;strokeColor=none;fillColor=#FFFFFF;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=10;fontColor=#1E2B3A;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="1006" y="364" width="150" height="28" as="geometry" />
        </mxCell>
        <mxCell id="lmp_mean_d" value="+80 EUR/MWh (+123 %)" style="text;html=1;strokeColor=none;fillColor=#FFFFFF;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=10;fontColor=#C4372A;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="1156" y="364" width="190" height="28" as="geometry" />
        </mxCell>

        <mxCell id="lmp_max_m" value="Max LMP" style="text;html=1;strokeColor=none;fillColor=#F3F7FF;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=10;fontColor=#1E2B3A;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="736" y="392" width="120" height="28" as="geometry" />
        </mxCell>
        <mxCell id="lmp_max_b" value="180 EUR/MWh" style="text;html=1;strokeColor=none;fillColor=#F3F7FF;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=10;fontColor=#1E2B3A;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="856" y="392" width="150" height="28" as="geometry" />
        </mxCell>
        <mxCell id="lmp_max_s" value="380 EUR/MWh" style="text;html=1;strokeColor=none;fillColor=#F3F7FF;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=10;fontColor=#1E2B3A;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="1006" y="392" width="150" height="28" as="geometry" />
        </mxCell>
        <mxCell id="lmp_max_d" value="+200 EUR/MWh (+111 %)" style="text;html=1;strokeColor=none;fillColor=#F3F7FF;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=10;fontColor=#C4372A;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="1156" y="392" width="190" height="28" as="geometry" />
        </mxCell>

        <!-- ENS detail -->
        <mxCell id="ens_detail_title" value="ENS DISTRIBUTION ANALYSIS" style="text;html=1;strokeColor=none;fillColor=#072A75;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=1;fontSize=10;fontStyle=1;fontColor=#FFFFFF;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="736" y="440" width="610" height="24" as="geometry" />
        </mxCell>
        <mxCell id="ens_item1" value="Temporal concentration: 80 % of ENS falls in evening peak hours (18:00-21:00) and morning ramp-up (06:00-08:00). Off-peak hours have adequate supply." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=9;fontColor=#1E2B3A;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="750" y="472" width="582" height="34" as="geometry" />
        </mxCell>
        <mxCell id="ens_item2" value="Regional asymmetry: Northern Romanian regions hit hardest (farther from domestic hydro and baseload). Bucharest-area regions fare better due to local generation concentration." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=9;fontColor=#1E2B3A;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="750" y="510" width="582" height="34" as="geometry" />
        </mxCell>
        <mxCell id="ens_item3" value="Neighbour impact: BG, HU, RS are unaffected (ENS = 0) -- the shock is unilateral (Romania only). Neighbours continue normal operation with their own supply." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=9;fontColor=#1E2B3A;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="750" y="548" width="582" height="34" as="geometry" />
        </mxCell>
        <mxCell id="ens_item4" value="Capacity gap estimate: ~5.6 GWh/day average shortfall -→gt; need 1-2 large gas peaker plants (500 MW each) or ~2 GW of renewable + battery storage to close the gap." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=9;fontColor=#1E2B3A;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="750" y="586" width="582" height="34" as="geometry" />
        </mxCell>

        <!-- Bottom: Policy implications -->
        <mxCell id="policy_bg" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C7D5EF;strokeWidth=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="656" width="1320" height="140" as="geometry" />
        </mxCell>
        <mxCell id="policy_title" value="POLICY &amp; INFRASTRUCTURE IMPLICATIONS" style="text;html=1;strokeColor=none;fillColor=#072A75;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=1;fontSize=12;fontStyle=1;fontColor=#FFFFFF;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="40" y="656" width="1320" height="26" as="geometry" />
        </mxCell>
        <mxCell id="pol1" value="Import dependency: Romania is 15-20 % import-dependent for meeting peak winter demand with current domestic capacity. Cross-border isolation alone, even without demand surge, would stress the system." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDF5FF;strokeColor=#C7D5EF;strokeWidth=1;fontSize=9;fontColor=#1E2B3A;fontFamily=Helvetica;align=left;spacingLeft=10;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="56" y="694" width="310" height="92" as="geometry" />
        </mxCell>
        <mxCell id="pol2" value="Storage leverage: Evening-peak concentration (~80 % of ENS) makes batteries and pumped hydro disproportionately effective -- 2-4 GWh of storage could eliminate most blackout hours." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDF5FF;strokeColor=#C7D5EF;strokeWidth=1;fontSize=9;fontColor=#1E2B3A;fontFamily=Helvetica;align=left;spacingLeft=10;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="378" y="694" width="310" height="92" as="geometry" />
        </mxCell>
        <mxCell id="pol3" value="Demand flexibility: Shifting 10-15 % of peak demand to off-peak hours dramatically reduces ENS. EV smart charging, industrial load shifting, and dynamic tariffs are high-leverage interventions." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDF5FF;strokeColor=#C7D5EF;strokeWidth=1;fontSize=9;fontColor=#1E2B3A;fontFamily=Helvetica;align=left;spacingLeft=10;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="700" y="694" width="310" height="92" as="geometry" />
        </mxCell>
        <mxCell id="pol4" value="Interconnector value: Each GWh of import capacity is worth 12-15 M EUR under stress -- quantitative input for PCI cost-benefit analysis and TYNDP scenario development." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDF5FF;strokeColor=#C7D5EF;strokeWidth=1;fontSize=9;fontColor=#1E2B3A;fontFamily=Helvetica;align=left;spacingLeft=10;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="1022" y="694" width="322" height="92" as="geometry" />
        </mxCell>

        <mxCell id="caption" value="Results are deterministic envelopes for calibration, not probabilistic forecasts. The 2^5 orthogonal shock combination space supports full sensitivity sweeps; this case study is one cell." style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=9;fontStyle=2;fontColor=#5D6A7B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="40" y="810" width="1320" height="20" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
