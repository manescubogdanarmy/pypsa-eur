        <!-- Gen mix note -->
        <mxCell id="gen_note" value="Renewables (wind, solar) are weather-fixed and cannot increase. Nuclear already at maximum. Hydro reduced by shock. Gas and coal attempt to compensate but are constrained by capacity reduction and SCADA ramp-rate limits. The gap manifests as ENS." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=9;fontStyle=2;fontColor=#5D6A7B;fontFamily=Helvetica;" vertex="1" parent="1">
